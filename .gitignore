# ---------------------------------------------------------------------------
# Python (dataset preparation, training, export — scripts/)
# ---------------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Downloaded archives are never committed.
*.zip
*.tar
*.tar.gz
*.7z

# Pretrained weights are fetched on demand by the training script.
yolo26n.pt

# ---------------------------------------------------------------------------
# Dataset (datasets/binsight_waste_3class)
# ---------------------------------------------------------------------------
#
# 5,074 images and their labels — 123 MB — do not belong in a portfolio
# repository. Everything needed to rebuild them byte-for-byte IS committed: the
# preparation script, the validator, data.yaml and the reports. See the README
# for the reproduction commands.
datasets/_tmp/
datasets/**/images/
datasets/**/labels/

# ...but keep the small reproducibility metadata trackable. Stated explicitly
# because the two rules above are broad.
!datasets/binsight_waste_3class/data.yaml
!datasets/binsight_waste_3class/dataset_report.md
!datasets/binsight_waste_3class/manifest.csv
!datasets/binsight_waste_3class/prepare_summary.json
!datasets/binsight_waste_3class/validation_report.json

# ---------------------------------------------------------------------------
# Training runs (runs/)
# ---------------------------------------------------------------------------
#
# 460 MB of Ultralytics output: best.pt, last.pt, 25 per-epoch checkpoints from
# save_period=1, batch previews and plots. The deployable artifact is the
# CoreML package, which IS committed; the training record that matters is
# reports/yolo26n_training_report.md, which carries the metrics and the
# checkpoint's SHA-256.
runs/

# Generated preview and parity renders. Regenerated by
# scripts/evaluate_yolo26n.py and scripts/verify_coreml_parity.py.
artifacts/

# ---------------------------------------------------------------------------
# Release artifacts and export workspace (models/)
# ---------------------------------------------------------------------------
#
# Two release artifacts ARE committed, and they are the only two:
#
#     models/pytorch/BinSightYOLO26n.pt                     <- 5.1 MB, the
#         accepted training checkpoint, byte-identical to
#         runs/.../weights/best.pt (sha256 958e49a5…4f58ed67). Preserved here so
#         the release model survives without committing the 460 MB runs/ tree.
#
#     BinSight/Resources/Models/BinSightYOLO26n.mlpackage   <- 4.8 MB, what the
#         iOS target compiles and bundles.
#
# `scripts/export_yolo26n_coreml.py` writes its output to models/coreml/, which
# is then copied into the app target. Tracking that too would put two
# byte-identical 4.8 MB copies in Git, so the export output is ignored while the
# small JSON beside it — the verification record — is kept.
models/coreml/*.mlpackage/

# Kept on purpose — the CoreML model the iOS target compiles and bundles.
# Stated explicitly so no future rule can quietly drop the app's only model.
!BinSight/Resources/Models/
!BinSight/Resources/Models/**
