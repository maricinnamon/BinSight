    "unavailable.permissionDenied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access needed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до камери"
          }
        }
      }
    },
    "unavailable.permissionDenied.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BinSight needs the camera to look at an item. Nothing is recorded or uploaded."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "BinSight потрібна камера, щоб побачити предмет. Нічого не записується й не надсилається."
          }
        }
      }
    },
    "unavailable.permissionRestricted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera not allowed"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера заборонена"
          }
        }
      }
    },
    "unavailable.permissionRestricted.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is turned off by a restriction on this device, such as Screen Time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери вимкнено обмеженням на цьому пристрої — наприклад, «Екранним часом»."
          }
        }
      }
    },
    "unavailable.cameraUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera unavailable"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна"
          }
        }
      }
    },
    "unavailable.cameraUnavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is available on this device right now."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз на цьому пристрої немає доступної камери."
          }
        }
      }
    },
    "unavailable.interrupted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera paused"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камеру призупинено"
          }
        }
      }
    },
    "unavailable.interrupted.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something else is using the camera. It will resume on its own when that finishes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камеру використовує інший застосунок. Робота відновиться сама, коли він завершить."
          }
        }
      }
    },
    "unavailable.captureFailed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera stopped"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера зупинилася"
          }
        }
      }
    },
    "unavailable.captureFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera stopped unexpectedly."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера несподівано зупинилася."
          }
        }
      }
    },
    "unavailable.modelUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detector unavailable"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Детектор недоступний"
          }
        }
      }
    },
    "unavailable.modelUnavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device model could not be loaded, so nothing can be recognised yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити модель на пристрої, тому розпізнавання поки неможливе."
          }
        }
      }
    },
    "recovery.retry.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробувати ще раз"
          }
        }
      }
    },
    "recovery.openSettings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити Налаштування"
          }
        }
      }
    },
    "state.ready.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready when you are"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово, коли ви готові"
          }
        }
      }
    },
    "state.ready.supporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold steady and let one item fill the frame."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте рівно, щоб предмет займав кадр."
          }
        }
      }
    },
    "state.modelLoading.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting the model ready…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готуємо модель…"
          }
        }
      }
    },
    "state.modelLoading.supporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This happens once, on this device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відбувається один раз, на цьому пристрої."
          }
        }
      }
    },
    "state.scanning.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the item…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнаємо предмет…"
          }
        }
      }
    },
    "state.scanning.supporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working it out on this iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислюємо просто на цьому iPhone."
          }
        }
      }
    },
    "state.result.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best match"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкращий збіг"
          }
        }
      }
    },
    "state.notSure.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No confident match"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає впевненого збігу"
          }
        }
      }
    },
    "state.notSure.supporting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More light, move closer, or use a plainer background."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте світла, підійдіть ближче або приберіть зайве з фону."
          }
        }
      }
    },
    "state.notSure.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure — try a clearer angle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не впевнені — спробуйте інший ракурс"
          }
        }
      }
    },
    "chip.onDeviceAI": {
      "extractionState": "manual",
