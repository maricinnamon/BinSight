    "waste.paper.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paper"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папір"
          }
        }
      }
    },
    "waste.plastic.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plastic"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пластик"
          }
        }
      }
    },
    "waste.generalWaste.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General waste"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змішані відходи"
          }
        }
      }
    },
    "waste.cardboard.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flatten it and keep it dry."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Складіть і тримайте сухим."
          }
        }
      }
    },
    "waste.glass.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty and rinse it. Lids usually go separately."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спорожніть і сполосніть. Кришки зазвичай здають окремо."
          }
        }
      }
    },
    "waste.metal.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinse it out. Labels can normally stay on."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сполосніть. Етикетку зазвичай можна не знімати."
          }
        }
      }
    },
    "waste.paper.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it clean and dry — no food-soiled paper."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Має бути чистим і сухим — забруднений їжею папір не підходить."
          }
        }
      }
    },
    "waste.plastic.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty and rinse it, then put the cap back on."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спорожніть, сполосніть і закрутіть кришку назад."
          }
        }
      }
    },
    "waste.generalWaste.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recycling stream fits this one."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього немає окремого потоку переробки."
          }
        }
      }
    },
    "detected.paper.name": {
      "extractionState": "manual",
      "localizations": {
